    "meta_analysis_methodology": {
      "value": {
        "name_zh": "元分析-核算方法偏差检验",
        "name_en": "Meta-Analysis: Accounting Methodology Bias",
        "use_case": "检验不同核算方法(排放因子法/实测法/模型法)是否导致系统性偏差",
        "applicable_domain": "污水处理厂温室气体排放、碳排放核算、环境科学文献综述",
        "workflow": [
          "1. 数据清洗: 方法学分类标准化(排放因子法/实测法/模型法/混合法)",
          "2. 异常值剔除: IQR法(1.5倍四分位距)，逐气体独立剔除",
          "3. 分组描述统计: 均值、中位数、标准差、95%CI、CV",
          "4. Kruskal-Wallis H检验: 非参数多组比较(适合非正态数据)",
          "5. 效应量计算: eta-squared(组间SS/总SS)",
          "6. 两两比较: Mann-Whitney U检验 + Bonferroni校正",
          "7. 效应量: Cohen's d(标准化均值差) + r(Z/sqrtN)",
          "8. 异质性分析: Cochran Q统计量 + I-squared"
        ],
        "key_tests": {
          "overall": "Kruskal-Wallis H检验 (p<0.05表示方法间存在显著差异)",
          "pairwise": "Mann-Whitney U + Bonferroni校正 (alpha=0.05/n_comparisons)",
          "effect_size": "eta-squared: <0.01极小, 0.01-0.06小, 0.06-0.14中等, >0.14大",
          "cohens_d": "|d|<0.2无差异, 0.2-0.5小, 0.5-0.8中等, >0.8大"
        },
        "report_format": "KW H={H:.4f}, p={p:.4f}, eta2={eta2:.4f}; pairwise: U={U:.1f}, p={p:.4f}, r={r:.3f}",
        "visualization": [
          "森林图(Forest Plot): 各方法均值+95%CI",
          "箱线图+散点: 方法间分布对比",
          "效应量柱状图: Cohen's d比较"
        ],
        "findings_template": "CH4和N2O的核算方法偏差显著(p<0.05)，排放因子法系统性偏高; CO2不受方法学影响; 组内异质性极高(I2>99%)说明方法学不是唯一偏差来源",
        "limitations": [
          "部分方法学分组样本量小，统计检验力有限",
          "文献异质性高，不同研究边界条件差异大",
          "未考虑发表偏倚"
        ]
      },
      "confidence": 0.9,
      "source": "meta_analysis_v2.py",
      "updated": "2026-06-09T00:00:00+00:00",
      "version": 1
    },
    "dispersion_analysis": {
      "value": {
        "name_zh": "离散分析-方法内部变异特征",
        "name_en": "Dispersion Analysis: Methodology Internal Variability",
        "use_case": "分析不同核算方法内部的离散程度、变异来源、分布稳定性",
        "applicable_domain": "跨研究数据比较、方法学评估、环境科学文献综述",
        "workflow": [
          "1. 数据清洗: 方法学分类 + IQR异常值剔除",
          "2. 基础离散指标: 标准差、IQR、CV、MAD、Robust CV(IQR/中位数)",
          "3. 方差齐性检验: Levene检验(非参数) + Bartlett检验(参数)",
          "4. 变异系数排序: CV从小到大=稳定性从高到低",
          "5. 稳健离散指标: MAD(Median Absolute Deviation) + Robust CV",
          "6. 分布形态: 偏度(Skewness) + 峰度(Kurtosis)",
          "7. 方差分解: 组间(Method) vs 组内(Within) SS占比"
        ],
        "key_metrics": {
          "CV": "变异系数=标准差/均值*100%，>100%为高变异",
          "MAD": "中位数绝对偏差=median(|xi-median|)，不受异常值影响",
          "robust_cv": "稳健CV=IQR/中位数*100%，适合偏态数据",
          "skewness": "偏度: >1右偏, <-1左偏, -1~1近似对称",
          "kurtosis": "峰度: >1尖峰(重尾), <-1平峰(轻尾), -1~1正态峰",
          "levene_p": "Levene p<0.05表示不同组的离散程度存在显著差异",
          "variance_decomposition": "组间SS/总SS=方法学解释的变异比例"
        },
        "report_format": "Levene W={W:.4f}, p={p:.4f}; CV={cv:.1f}%; MAD={mad:.3f}; skew={skew:.2f}, kurtosis={kurt:.2f}",
        "visualization": [
          "CV与稳健CV对比柱状图",
          "箱线图+IQR标注",
          "方差分解堆叠柱状图(组间vs组内)",
          "偏度-峰度散点图",
          "标准差vs MAD对比图"
        ],
        "interpretation_rules": [
          "实测法CV最高但最真实: 捕获了真实工况变异",
          "排放因子法CV最低但可能失真: 统一因子人为压缩变异",
          "方法学解释的变异<20%: 工艺/规模/气候是主要变异来源",
          "右偏分布: 使用中位数和IQR优于均值和标准差",
          "Std/MAD>2: 存在异常值影响，MAD更稳健"
        ],
        "findings_template": "所有方法内部均呈高离散性(CV>80%); 实测法最不稳定但最真实; 排放因子法最稳定但可能失真; 方法学仅解释9-17%总变异",
        "limitations": [
          "高CV可能反映真实变异而非方法缺陷",
          "样本量小时CV估计不稳定",
          "IQR法剔除异常值可能丢失有意义的极端值"
        ]
      },
      "confidence": 0.9,
      "source": "dispersion_analysis.py",
      "updated": "2026-06-09T00:00:00+00:00",
      "version": 1
    },
