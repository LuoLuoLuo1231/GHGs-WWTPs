    "iqr_outlier": {
      "value": {
        "name_zh": "IQR异常值剔除法",
        "name_en": "IQR Outlier Removal",
        "use_case": "基于四分位距识别和剔除异常值",
        "formula": "异常值: x < Q1 - 1.5*IQR 或 x > Q3 + 1.5*IQR",
        "steps": [
          "1. 计算Q1(25%分位数)和Q3(75%分位数)",
          "2. 计算IQR = Q3 - Q1",
          "3. 下界 = Q1 - 1.5*IQR, 上界 = Q3 + 1.5*IQR",
          "4. 超出边界的值标记为异常值并剔除"
        ],
        "advantages": "不受极端值影响，适合偏态分布",
        "report_format": "剔除{n}个异常值 (IQR={iqr:.3f}, bounds=[{lower:.3f}, {upper:.3f}])"
      },
      "confidence": 0.95,
